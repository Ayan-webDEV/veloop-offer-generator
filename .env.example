# Resend Channel 2 (starts after Channel 1 reaches 100 daily attempts)
RESEND_API_KEY_2=
RESEND_FROM_EMAIL_2=

# Brevo transactional API for delayed WhatsApp-group reminder
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Team VELoop Rewards
BREVO_REPLY_TO=
