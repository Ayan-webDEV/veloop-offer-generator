DASHBOARD_PASSWORD=
MONGODB_URI=
MONGODB_DB_NAME=veloop_offers
INTERN_ID_START_NUMBER=1
INTERN_VERIFICATION_API_KEY=

EMAIL_PROVIDER=resend
# Resend Channel 1
RESEND_API_KEY=
